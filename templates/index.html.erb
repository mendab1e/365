<section class="feed" aria-label="Photo feed">
  <% if photos.empty? %>
    <div class="empty-state">
      <h1>The first photo is coming soon.</h1>
      <p>This daily photo project will begin here.</p>
    </div>
  <% else %>
    <% photos.reverse_each do |photo| %>
      <article class="photo-post" id="photo-<%= photo.fetch(:date) %>">
        <h1><a href="<%= public_path("posts/#{photo.fetch(:date)}.html") %>"><%= long_date(photo) %></a></h1>
        <%= render("photo", photo:, deferred: true) %>
      </article>
    <% end %>
  <% end %>
</section>
<button class="back-to-top" type="button" aria-label="Back to top" title="Back to top" hidden>
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M3 10.5 8 5.5l5 5"></path>
  </svg>
</button>
