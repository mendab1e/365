#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "year_in_photos"

config = YearInPhotos::Config.from_env
store = YearInPhotos::PhotoStore.new(config.data_dir)
generator = YearInPhotos::SiteGenerator.new(config:, store:)
processor = YearInPhotos::ImageProcessor.new(config:)
telegram = YearInPhotos::TelegramClient.new(config.telegram_token)

generator.generate!
YearInPhotos::Bot.new(
  config:,
  store:,
  services: YearInPhotos::Bot::Services.new(generator:, processor:, telegram:)
).run
